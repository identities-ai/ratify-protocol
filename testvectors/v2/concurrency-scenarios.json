          "terminal_b64": "eyJkZWNpc2lvbiI6ImluZGV0ZXJtaW5hdGUiLCJkZWNpc2lvbl9yZWFzb24iOiJzdGF0dXNfdW5hdmFpbGFibGUiLCJpZGVudGl0eV9zdGF0dXMiOiJhdXRob3JpemF0aW9uX3VudmVyaWZpZWQifQ==",
          "body_b64": ""
        },
        {
          "group": "recoverers",
          "count": 3,
          "op": "recover_direct",
          "request": "A",
          "terminal_b64": "eyJkZWNpc2lvbiI6ImluZGV0ZXJtaW5hdGUiLCJkZWNpc2lvbl9yZWFzb24iOiJldmFsdWF0aW9uX2ludGVycnVwdGVkIiwiaWRlbnRpdHlfc3RhdHVzIjoiYXV0aG9yaXphdGlvbl91bnZlcmlmaWVkIn0=",
          "body_b64": ""
        },
        {
          "group": "clock",
          "count": 1,
          "op": "set_time",
          "time": 1800000030
        }
      ],
      "invariants": [
        {
          "kind": "count",
          "groups": [
            "owner",
            "recoverers"
          ],
          "outcomes": [
            "committed"
          ],
          "at_most": 1
        },
        {
          "kind": "one_winner",
          "winning": [
            "committed"
          ],
          "by_group": {
            "owner": {
              "if_winner": [
                "committed"
              ],
              "if_loser": [
                "error/claim_lease_lost",
