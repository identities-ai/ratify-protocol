            "group": "owner",
            "cases": {
              "committed": {
                "error_class": "claim_already_terminal"
              },
              "error/claim_already_terminal": {
                "stage": "committed",
                "decision": "indeterminate",
                "decision_reason": "evaluation_interrupted",
                "trust_assessment": "not_evaluated",
                "status_assessment": "not_evaluated",
                "context_assessment": "not_evaluated"
              },
              "error/claim_lease_lost": {
                "stage": "committed",
                "decision": "indeterminate",
                "decision_reason": "evaluation_interrupted",
                "trust_assessment": "not_evaluated",
                "status_assessment": "not_evaluated",
                "context_assessment": "not_evaluated"
              }
