{
  "version": 1,
  "description": "Digest functions over explicit object type codes (SPEC-v2 §4). A code outside the registry of §4 (0x0000 is reserved and invalid; 0x000a and above are unassigned) is unsupported_object_type and produces no digest. expected_digest is sha384: and 96 lowercase hexadecimal characters.",
  "functions": {
    "statement_body_digest": "StatementBodyDigest(object_type_code, input), where input_b64 is the canonical signable body",
    "status_evidence_digest": "StatusEvidenceDigest(object_type_code, object), where input_b64 is a complete signed revocation list wire object decoded strictly before the call"
  },
  "cases": [
    {
      "name": "statement_body_rotation",
      "description": "StatementBodyDigest of a rotation signable body",
      "function": "statement_body_digest",
      "object_type_code": 4,
      "input_b64": "",
      "expected_digest": "sha384:707aa3a8ec652027527b3ee2b26f84a6a1292ab4cf9809979b686b32b23144c5b7c5d48c7a607f5c96e97b1dff9d7242"
    },
    {
      "name": "statement_body_witness_entry",
      "description": "StatementBodyDigest of a witness_entry signable body",
      "function": "statement_body_digest",
      "object_type_code": 6,
      "input_b64": "",
      "expected_digest": "sha384:e4c1477dc3dc58824e358955178d6c65efca52839bfae86f1dfedb4e91191da77edce0b32b9ed686870da2f057b55c4b"
    },
    {
      "name": "statement_body_verification_receipt",
      "description": "StatementBodyDigest of a verification_receipt signable body",
      "function": "statement_body_digest",
      "object_type_code": 8,
      "input_b64": "",
      "expected_digest": "sha384:35bdba58b014c7bedbbc863caabdc5b0b33f735e1776a3a72452c0229220fa44b1cd7f85e1c6249cf2646ef3d1e0da3c"
    },
    {
      "name": "status_evidence_revocation_list",
      "description": "StatusEvidenceDigest of a complete signed revocation list",
      "function": "status_evidence_digest",
      "object_type_code": 3,
      "input_b64": "",
      "expected_digest": "sha384:fecdcbc0da2068ef62507755877f3b7362a8e883bc1f7b7629dfe999b20229e0994ce35565b949381eae86f59557f01b"
    },
    {
      "name": "statement_body_unregistered_0000",
      "description": "StatementBodyDigest asked for code 0x0000, outside the registry",
      "function": "statement_body_digest",
      "object_type_code": 0,
      "input_b64": "",
      "expected_error_class": "unsupported_object_type"
    },
    {
      "name": "status_evidence_unregistered_0000",
      "description": "StatusEvidenceDigest asked for code 0x0000, outside the registry",
      "function": "status_evidence_digest",
      "object_type_code": 0,
      "input_b64": "",
      "expected_error_class": "unsupported_object_type"
    },
    {
      "name": "statement_body_unregistered_000a",
      "description": "StatementBodyDigest asked for code 0x000a, outside the registry",
      "function": "statement_body_digest",
      "object_type_code": 10,
      "input_b64": "",
      "expected_error_class": "unsupported_object_type"
    },
    {
      "name": "status_evidence_unregistered_000a",
      "description": "StatusEvidenceDigest asked for code 0x000a, outside the registry",
      "function": "status_evidence_digest",
      "object_type_code": 10,
      "input_b64": "",
      "expected_error_class": "unsupported_object_type"
    },
    {
      "name": "statement_body_unregistered_ffff",
      "description": "StatementBodyDigest asked for code 0xffff, outside the registry",
      "function": "statement_body_digest",
      "object_type_code": 65535,
      "input_b64": "",
      "expected_error_class": "unsupported_object_type"
    },
    {
      "name": "status_evidence_unregistered_ffff",
      "description": "StatusEvidenceDigest asked for code 0xffff, outside the registry",
      "function": "status_evidence_digest",
      "object_type_code": 65535,
      "input_b64": "",
      "expected_error_class": "unsupported_object_type"
    }
  ]
}
