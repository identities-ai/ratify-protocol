        },
        {
          "op": "ingest",
          "at": 1799994601,
          "publication": 1,
          "object": "list",
          "expect": {
            "result": "applied"
          }
        },
        {
          "op": "status",
          "at": 1799996500,
          "cert_id": "cert-leaf",
          "expect": {
            "status": "not_revoked"
          }
        },
        {
          "op": "heartbeat",
          "at": 1799994600,
          "expect": {
            "result": "refused"
          }
        },
        {
          "op": "heartbeat",
          "at": 1799993800,
          "expect": {
            "result": "refused"
          }
        }
      ]
