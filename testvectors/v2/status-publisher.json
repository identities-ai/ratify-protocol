          "expect": {
            "result": "refused"
          }
        },
        {
          "op": "revoke",
          "at": 1799992820,
          "expect": {
            "result": "refused"
          }
        },
        {
          "op": "revoke",
          "at": 1799992820,
          "cert_ids": [
            "cert-a",
            "cert-a"
